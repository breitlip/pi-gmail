{
  "name": "pi-gmail",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Gmail tools for pi via local IMAP/SMTP with app-password auth (no third-party cloud)",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import jiti/register --test \"test/*.test.ts\"",
    "test:live": "GMAIL_LIVE=1 node --import jiti/register --test \"test/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.3",
    "jiti": "^2.7.0",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
